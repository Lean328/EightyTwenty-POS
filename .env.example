# EightyTwenty POS configuration. Copy to `.env.local` (development) or `.env.production.local` (builds).
# Every VITE_* value is compiled into the browser bundle and is visible to anyone using the till:
# never put secrets, API keys or credentials here. Staff authenticate individually with their PIN.

# Where the till's data comes from:
#   local — development data kept in this browser only (sample menu, customers and orders). Default for `npm run dev`.
#   http  — the shared EightyTwenty backend. Required for production.
VITE_DATA_PROVIDER=local

# Base URL of the EightyTwenty backend API (http provider only). Must be https:// outside localhost.
# The API contract is a proposal — see docs/INTEGRATIONS.md.
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Identifies this till to the backend (order numbering, audit trail, device pairing).
VITE_TERMINAL_ID=TILL-1

# Development simulators (mock website/app intake, connection loss, simulated card terminal and printers).
# Always on in `npm run dev` with the local provider; never available with the http provider.
VITE_ENABLE_DEV_TOOLS=false

# A production build refuses to start with local development data unless this is set (e.g. a sales demo).
VITE_ALLOW_LOCAL_DATA_IN_PRODUCTION=false
