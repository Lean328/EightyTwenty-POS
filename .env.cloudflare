# Hosted build on Cloudflare (`npm run build:cloudflare`). Nothing here is secret: it is compiled into the page.
VITE_DATA_PROVIDER=http
VITE_API_BASE_URL=https://eightytwenty-api.onrender.com
VITE_API_TIMEOUT_MS=15000
# Default only: each device sets its own with ?terminal=BRADDON-TILL-1 (remembered on that device).
VITE_TERMINAL_ID=TILL-1
